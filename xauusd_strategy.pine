// ============================================================
// XAU/USD Advanced Strategy — Pine Script v5
// EMA Trend + RSI Dip/Top + MACD Confirmation + ATR SL/TP
// Risk Management: 2% per trade | R:R 1:2
// ============================================================
//@version=5
strategy(
     title            = "XAU/USD Advanced Strategy [EMA+RSI+MACD+ATR]",
     shorttitle       = "XAU Advanced",
     overlay          = true,
     initial_capital  = 10000,
     currency         = currency.USD,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 2,
     commission_type  = strategy.commission.percent,
     commission_value = 0.07,
     slippage         = 3
     )

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
grpTrend  = "Trend — EMAs"
emaFast   = input.int(50,  "EMA Rapide",  minval=1,  group=grpTrend)
emaSlow   = input.int(200, "EMA Lente",   minval=1,  group=grpTrend)

grpRSI    = "RSI"
rsiLen    = input.int(14,  "Longueur RSI", minval=1, group=grpRSI)
rsiOS     = input.int(30,  "Survendu",     minval=1, maxval=50, group=grpRSI)
rsiOB     = input.int(70,  "Suracheté",    minval=50, maxval=99, group=grpRSI)

grpMACD   = "MACD"
macdFast  = input.int(12, "MACD Rapide",  minval=1, group=grpMACD)
macdSlow  = input.int(26, "MACD Lent",    minval=1, group=grpMACD)
macdSig   = input.int(9,  "Signal MACD",  minval=1, group=grpMACD)

grpRisk   = "Risque"
atrLen    = input.int(14,  "Longueur ATR",    minval=1,  group=grpRisk)
atrMult   = input.float(1.5, "Multiplicateur ATR (SL)", minval=0.1, step=0.1, group=grpRisk)
rrRatio   = input.float(2.0, "Ratio R:R (TP)",          minval=0.5, step=0.5, group=grpRisk)

// ─────────────────────────────────────────────
// INDICATEURS
// ─────────────────────────────────────────────
ema50  = ta.ema(close, emaFast)
ema200 = ta.ema(close, emaSlow)

rsiVal = ta.rsi(close, rsiLen)

[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSig)

atrVal = ta.atr(atrLen)

// ─────────────────────────────────────────────
// CONDITIONS DE TENDANCE
// ─────────────────────────────────────────────
bullTrend = ema50 > ema200   // tendance haussière
bearTrend = ema50 < ema200   // tendance baissière

// ─────────────────────────────────────────────
// SIGNAUX BRUTS
// ─────────────────────────────────────────────
// ACHAT : tendance haussière + RSI sort de survente + MACD haussier
rsiOversold     = rsiVal < rsiOS
rsiExitOversold = ta.crossover(rsiVal, rsiOS)   // RSI remonte au-dessus de 30
macdBull        = macdLine > signalLine and histLine > 0

longSignal  = bullTrend and rsiExitOversold and macdBull

// VENTE : tendance baissière + RSI sort de surachat + MACD baissier
rsiOverbought    = rsiVal > rsiOB
rsiExitOverbought = ta.crossunder(rsiVal, rsiOB)  // RSI repasse sous 70
macdBear         = macdLine < signalLine and histLine < 0

shortSignal = bearTrend and rsiExitOverbought and macdBear

// ─────────────────────────────────────────────
// GESTION DES POSITIONS (SL / TP dynamiques ATR)
// ─────────────────────────────────────────────
var float entryPrice  = na
var float stopLoss    = na
var float takeProfit  = na

// Calcul au moment de l'entrée
if longSignal and strategy.position_size == 0
    entryPrice := close
    stopLoss   := close - atrVal * atrMult
    takeProfit := close + (atrVal * atrMult) * rrRatio
    strategy.entry("Long", strategy.long)

if shortSignal and strategy.position_size == 0
    entryPrice := close
    stopLoss   := close + atrVal * atrMult
    takeProfit := close - (atrVal * atrMult) * rrRatio
    strategy.entry("Short", strategy.short)

// Applique SL / TP sur positions ouvertes
if strategy.position_size > 0
    strategy.exit("SL/TP Long",  from_entry="Long",  stop=stopLoss, limit=takeProfit)

if strategy.position_size < 0
    strategy.exit("SL/TP Short", from_entry="Short", stop=stopLoss, limit=takeProfit)

// ─────────────────────────────────────────────
// AFFICHAGE DES EMAs
// ─────────────────────────────────────────────
plot(ema50,  title="EMA 50",  color=color.new(color.orange, 0), linewidth=2)
plot(ema200, title="EMA 200", color=color.new(color.blue,   0), linewidth=2)

// ─────────────────────────────────────────────
// ZONES VISUELLES D'ACHAT / VENTE
// ─────────────────────────────────────────────
// Signal d'achat — fond vert
bgcolor(
     longSignal  ? color.new(color.green, 80) : na,
     title="Zone Achat"
     )

// Signal de vente — fond rouge
bgcolor(
     shortSignal ? color.new(color.red, 80) : na,
     title="Zone Vente"
     )

// Flèches sur le graphique
plotshape(
     longSignal,
     title     = "Signal Achat",
     style     = shape.labelup,
     location  = location.belowbar,
     color     = color.new(color.green, 0),
     textcolor = color.white,
     text      = "BUY",
     size      = size.normal
     )

plotshape(
     shortSignal,
     title     = "Signal Vente",
     style     = shape.labeldown,
     location  = location.abovebar,
     color     = color.new(color.red, 0),
     textcolor = color.white,
     text      = "SELL",
     size      = size.normal
     )

// ─────────────────────────────────────────────
// LIGNES SL / TP (positions ouvertes)
// ─────────────────────────────────────────────
// Stop-Loss
slPlot = plot(
     strategy.position_size != 0 ? stopLoss   : na,
     title      = "Stop-Loss",
     color      = color.new(color.red,    20),
     style      = plot.style_linebr,
     linewidth  = 2
     )

// Take-Profit
tpPlot = plot(
     strategy.position_size != 0 ? takeProfit : na,
     title      = "Take-Profit",
     color      = color.new(color.green,  20),
     style      = plot.style_linebr,
     linewidth  = 2
     )

// Prix d'entrée
epPlot = plot(
     strategy.position_size != 0 ? entryPrice : na,
     title      = "Prix d'Entrée",
     color      = color.new(color.yellow, 20),
     style      = plot.style_linebr,
     linewidth  = 1
     )

// ─────────────────────────────────────────────
// TABLE DE STATISTIQUES (backtesting)
// ─────────────────────────────────────────────
var table statsTable = table.new(
     position.top_right, 2, 9,
     bgcolor        = color.new(color.gray, 85),
     border_width   = 1,
     border_color   = color.new(color.gray, 60)
     )

if barstate.islast
    winRate  = strategy.wintrades / math.max(strategy.closedtrades, 1) * 100
    avgWin   = strategy.grossprofit  / math.max(strategy.wintrades,  1)
    avgLoss  = strategy.grossloss    / math.max(strategy.losstrades,  1)
    profFact = strategy.grossprofit  / math.max(math.abs(strategy.grossloss), 1)

    // En-tête
    table.cell(statsTable, 0, 0, "STATISTIQUES",
         text_color=color.white, text_size=size.small,
         bgcolor=color.new(color.navy, 20))
    table.cell(statsTable, 1, 0, "Valeur",
         text_color=color.white, text_size=size.small,
         bgcolor=color.new(color.navy, 20))

    // Données
    table.cell(statsTable, 0, 1, "P&L Net",      text_size=size.small, text_color=color.white)
    table.cell(statsTable, 1, 1,
         str.tostring(math.round(strategy.netprofit, 2)) + " $",
         text_size=size.small,
         text_color=strategy.netprofit >= 0 ? color.green : color.red)

    table.cell(statsTable, 0, 2, "Trades fermés", text_size=size.small, text_color=color.white)
    table.cell(statsTable, 1, 2,
         str.tostring(strategy.closedtrades),
         text_size=size.small, text_color=color.white)

    table.cell(statsTable, 0, 3, "Taux de réussite", text_size=size.small, text_color=color.white)
    table.cell(statsTable, 1, 3,
         str.tostring(math.round(winRate, 1)) + " %",
         text_size=size.small,
         text_color=winRate >= 50 ? color.green : color.orange)

    table.cell(statsTable, 0, 4, "Gain moyen",   text_size=size.small, text_color=color.white)
    table.cell(statsTable, 1, 4,
         str.tostring(math.round(avgWin, 2)) + " $",
         text_size=size.small, text_color=color.green)

    table.cell(statsTable, 0, 5, "Perte moyenne", text_size=size.small, text_color=color.white)
    table.cell(statsTable, 1, 5,
         str.tostring(math.round(avgLoss, 2)) + " $",
         text_size=size.small, text_color=color.red)

    table.cell(statsTable, 0, 6, "Profit Factor", text_size=size.small, text_color=color.white)
    table.cell(statsTable, 1, 6,
         str.tostring(math.round(profFact, 2)),
         text_size=size.small,
         text_color=profFact >= 1 ? color.green : color.red)

    table.cell(statsTable, 0, 7, "Drawdown Max",  text_size=size.small, text_color=color.white)
    table.cell(statsTable, 1, 7,
         str.tostring(math.round(strategy.max_drawdown, 2)) + " $",
         text_size=size.small, text_color=color.orange)

    table.cell(statsTable, 0, 8, "Capital Final", text_size=size.small, text_color=color.white)
    table.cell(statsTable, 1, 8,
         str.tostring(math.round(strategy.equity, 2)) + " $",
         text_size=size.small,
         text_color=strategy.equity >= strategy.initial_capital ? color.green : color.red)
